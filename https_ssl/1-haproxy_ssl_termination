global
    log /dev/log local0
    chroot /var/lib/haproxy
    stats socket /run/haproxy/admin.sock mode 660 level admin
    stats timeout 30s
    user haproxy
    group haproxy
    daemon
    h1-case-adjust x-served-by X-Served-By

defaults
    log global
    mode http
    option httplog
    option dontlognull
    timeout connect 5000
    timeout client 50000
    timeout server 50000

frontend http-in
    bind *:80
    option h1-case-adjust-bogus-client
    default_backend webservers

frontend https-in
    bind *:443 ssl crt /etc/haproxy/certs/www.gateteirene.tech.pem
    option h1-case-adjust-bogus-client
    default_backend webservers

backend webservers
    balance roundrobin
    server 7273-web-01 35.179.138.149:80 check
    server 7273-web-02 18.130.181.134:80 check
