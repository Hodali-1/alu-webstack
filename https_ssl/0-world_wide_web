#!/usr/bin/env bash
# Displays information about the subdomains of a domain
display_info() {
    local line
    line=$(dig "$2.$1" | grep -A1 'ANSWER SECTION:' | tail -1)
    echo "$line" | awk -v sub_domain="$2" '{print "The subdomain " sub_domain " is a " $4 " record and points to " $5}'
}
if [ "$#" -eq 1 ]; then
    for sub in www lb-01 web-01 web-02; do
        display_info "$1" "$sub"
    done
else
    display_info "$1" "$2"
fi
